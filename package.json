{
  "name": "cipherarena",
  "version": "1.0.0",
  "private": true,
  "description": "CipherArena CTF platform – MERN stack, deployed as one Render web service",
  "scripts": {
    "build": "npm install --prefix server && npm install --prefix client --include=dev && npm run build --prefix client",
    "start": "npm start --prefix server",
    "seed": "npm run seed --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "test:e2e": "node e2e/smoke-test.mjs",
    "test:premium": "node e2e/premium-test.mjs",
    "build:challenges": "npm run build:challenges --prefix server",
    "verify:challenges": "npm run verify:challenges --prefix server"
  },
  "engines": {
    "node": ">=20"
  }
}

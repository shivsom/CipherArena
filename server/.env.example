# Copy to .env for local development. On Render these are set in the dashboard.
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cipherarena
JWT_SECRET=<long-random-string>
# Premium Vault payments (Razorpay dashboard -> Account & Settings -> API keys). Use test keys first.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
# optional – webhook secret, webhook URL is https://<your-app>/api/premium/webhook (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=<webhook-secret>
PREMIUM_PRICE_INR=99
# only needed when the React build is hosted on another domain (Vercel / Netlify)
CLIENT_URL=http://localhost:5173
